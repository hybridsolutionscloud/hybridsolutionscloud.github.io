---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
  description:
    'Contact Hybrid Cloud Solutions about consulting, training, speaking engagements, and community collaboration.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Get In Touch"
    title="Let's Build Something Together"
    subtitle="For consulting, training, speaking, or collaboration inquiries, contact us directly by email."
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Email Us',
        href: 'mailto:contact@hybridsolutions.cloud',
        icon: 'tabler:mail',
      },
      {
        variant: 'secondary',
        text: 'Explore Services',
        href: '/services',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Start a Conversation</Fragment>
    <Fragment slot="subtitle">
      Email contact@hybridsolutions.cloud and include a short description of what you would like to discuss.
    </Fragment>
  </CallToAction>

  <Features2
    title="How We Can Help"
    items={[
      {
        title: 'Consulting',
        description: 'Architecture, deployment, and modernization for Microsoft hybrid cloud infrastructure.',
        icon: 'tabler:cloud-computing',
      },
      {
        title: 'Training',
        description: 'Practical technical training tailored to your team and environment.',
        icon: 'tabler:school',
      },
      {
        title: 'Speaking',
        description: 'Conference sessions, workshops, user groups, and community events.',
        icon: 'tabler:microphone',
      },
    ]}
  />
</Layout>
