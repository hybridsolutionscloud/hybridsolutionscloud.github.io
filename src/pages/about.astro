---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import kristopherImg from '~/assets/images/kristopher-turner.jpg';

const metadata = {
  title: 'About',
  description:
    'Meet Kristopher Turner — Microsoft MVP, MCT, and founder of Hybrid Cloud Solutions. 15+ years of hands-on experience with Azure, Hyper-V, and hybrid infrastructure.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'About Hybrid Cloud Solutions',
    }}
  >
    <Fragment slot="title">
      About <span class="text-accent dark:text-white">Hybrid Cloud Solutions</span>
    </Fragment>

    <Fragment slot="subtitle">
      Founded by Microsoft MVP and Microsoft Certified Trainer (MCT) Kristopher Turner — focused on bridging on-premises
      and cloud environments through real-world hybrid solutions. With deep expertise in Azure Local, Azure Arc, Azure
      Virtual Desktop, hybrid Kubernetes, Azure Monitor, Azure Site Recovery, multi-cloud governance, identity &
      security, and AI-driven Infrastructure as Code, Kristopher helps organizations modernize without abandoning what
      works.
    </Fragment>
  </Hero>

  <!-- Content Widget - Founder Story **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Microsoft MVP & MCT',
        description:
          'Microsoft MVP in Azure and a Microsoft Certified Trainer (MCT) — recognized for community leadership and deep technical expertise in hybrid cloud.',
      },
      {
        title: 'Cloud & Infrastructure Expert',
        description:
          'Focuses on delivering innovative cloud and infrastructure solutions with expertise in Azure Local, Azure Arc, AKS, ASR, and Azure Monitor.',
      },
      {
        title: 'Castlewood, Virginia',
        description:
          "Based in Castlewood, Virginia — bringing a craftsman's mindset to everything from cloud architecture to woodworking and slow-smoked Texas-style BBQ.",
      },
    ]}
    image={{
      src: kristopherImg,
      alt: 'Kristopher Turner — Microsoft MVP, MCT, Cloud & Infrastructure Expert',
      width: 400,
      height: 400,
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Meet Our Founder</h3>
      A sought-after speaker and thought leader, Kristopher frequently presents on hybrid architectures, cloud-native technologies,
      and monitoring solutions at conferences like MMS, M365 Community Days, Experts Live Europe, and Cloud and AI Summit
      — sharing insights from his extensive experience in modern IT infrastructure.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget - Mission **************** -->

  <Content
    items={[
      {
        title: 'Our Mission',
        description:
          'To bridge the gap between cloud and datacenter by delivering practical, resilient Microsoft hybrid cloud solutions that work for real people in real environments.',
      },
      {
        title: 'Our Approach',
        description:
          "Hybrid Cloud Solutions, LLC exists to make hybrid cloud simpler, more accessible, and better aligned to each organization's needs — whether you're modernizing a datacenter, enabling Azure Arc policy at the edge, or deploying resilient Hyper-V clusters with Storage Spaces Direct.",
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=2072&q=80',
      alt: 'Technology Vision',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Why We Exist</h3>
      Not every workload belongs in the public cloud. We help you modernize on your own terms.
    </Fragment>
  </Content>

  <!-- Features Widget - Core Values *************** -->

  <Features
    tagline="Values"
    title="Core Values"
    subtitle="The principles that guide everything we do."
    items={[
      {
        title: 'Craftsmanship in Tech',
        description:
          'We build hybrid systems with the precision of hand-made work. Quality matters in every deployment.',
        icon: 'tabler:hammer',
      },
      {
        title: 'Resilience',
        description:
          'Solutions should be as reliable as the people who depend on them. We design for uptime and survivability.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Simplicity',
        description: "Clear, modular, and supportable — technology should not overcomplicate what's possible.",
        icon: 'tabler:bulb',
      },
      {
        title: 'Rooted in Community',
        description:
          'We value collaboration, integrity, and purpose in every project. Giving back is part of who we are.',
        icon: 'tabler:users-group',
      },
    ]}
  />

  <!-- Content Widget - Web Properties: inthefog.cloud **************** -->

  <Content
    isReversed
    tagline="Our Web Properties"
    title="inthefog.cloud"
    subtitle="The hub for all of our hybrid cloud work — one place to find every project, tool, and guide."
    items={[
      {
        title: 'Azure Local',
        description: 'Deployment guides, automation, and the full set of Azure Local tools in one catalog.',
        icon: 'tabler:server-2',
      },
      {
        title: 'Hyper-V',
        description: 'Hyper-V and failover clustering guidance, with the Hyper-V planning and design tools.',
        icon: 'tabler:stack-2',
      },
      {
        title: 'Azure Arc',
        description: 'Bringing on-premises servers and services under Azure management.',
        icon: 'tabler:cloud-network',
      },
      {
        title: 'Hybrid Operations',
        description: 'Monitoring, ITSM, identity, and automation for environments that span datacenter and cloud.',
        icon: 'tabler:settings-automation',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=2072&q=80',
      alt: 'Hybrid cloud hub',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">inthefog.cloud</h3>
      <p class="mb-4">
        Our hybrid cloud hub. It brings together Azure Local, Hyper-V, Azure Arc, and hybrid operations — the projects,
        tools, and documentation from all of our sites — so you can find your way from one place.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="https://inthefog.cloud" target="_blank" rel="noopener noreferrer" class="btn btn-primary sm:w-auto">
          Visit inthefog.cloud
        </a>
        <a href="https://github.com/InTheFog-Cloud" target="_blank" rel="noopener noreferrer" class="btn sm:w-auto">
          GitHub: InTheFog-Cloud
        </a>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget - Web Properties: azurelocal.cloud **************** -->

  <Content
    tagline="Our Web Properties"
    title="azurelocal.cloud"
    subtitle="The dedicated Azure Local resource hub — tools, guides, and community projects."
    items={[
      {
        title: 'Azure Local SOFS FSLogix',
        description: 'Scale-Out File Server with FSLogix profile container support for Azure Local deployments.',
        icon: 'tabler:folders',
      },
      {
        title: 'Azure Local AVD',
        description:
          'Azure Virtual Desktop on Azure Local — deployment automation, image management, and hybrid AVD patterns.',
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Azure Local Load Tools',
        description: 'Performance testing and load simulation tools purpose-built for Azure Local clusters.',
        icon: 'tabler:gauge',
      },
      {
        title: 'Azure Local VM Conversion Toolkit',
        description:
          'Convert and migrate virtual machines to Azure Local — streamlined tooling for VMware, Hyper-V, and other sources.',
        icon: 'tabler:transform',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Azure Local infrastructure',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">azurelocal.cloud</h3>
      <p class="mb-4">
        A dedicated site for the Azure Local community — featuring open-source tools, deployment guides, and hands-on
        resources. New tools are being added weekly to the companion GitHub organization.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="https://azurelocal.cloud" target="_blank" rel="noopener noreferrer" class="btn btn-primary sm:w-auto">
          Visit azurelocal.cloud
        </a>
        <a href="https://github.com/AzureLocal" target="_blank" rel="noopener noreferrer" class="btn sm:w-auto">
          GitHub: AzureLocal
        </a>
      </div>
    </Fragment>
  </Content>

  <!-- Content Widget - Web Properties: labs.hybridsolutions.cloud **************** -->

  <Content
    isReversed
    tagline="Our Web Properties"
    title="labs.hybridsolutions.cloud"
    subtitle="Hybrid Cloud Solutions Labs — tools in preview and projects in the lab."
    items={[
      {
        title: 'AzureScout',
        description: 'Azure and Microsoft Entra inventory with Cloud Adoption and Well-Architected checks.',
        icon: 'tabler:radar',
      },
      {
        title: 'Hyper-V Surveyor and Trailwright',
        description: 'Plan, size, and design Windows Server Hyper-V clusters.',
        icon: 'tabler:ruler-measure',
      },
      {
        title: 'Azure Local Trailwright',
        description: 'A guided designer for Azure Local deployments, from requirements to exported configuration.',
        icon: 'tabler:route',
      },
      {
        title: 'Vault Prospector',
        description: 'A desktop explorer for Azure Key Vault metadata.',
        icon: 'tabler:key',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1551434678-e076c223a692?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Hybrid Cloud Solutions Labs',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">labs.hybridsolutions.cloud</h3>
      <p class="mb-4">
        Where new tools start. Labs hosts our preview and in-the-lab projects for Azure, Hyper-V, and hybrid operations,
        each with its own documentation.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="https://labs.hybridsolutions.cloud"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary sm:w-auto"
        >
          Visit Labs
        </a>
        <a
          href="https://github.com/Hybrid-Solutions-Cloud"
          target="_blank"
          rel="noopener noreferrer"
          class="btn sm:w-auto"
        >
          GitHub: Hybrid-Solutions-Cloud
        </a>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget - Web Properties: thisismydemo.cloud **************** -->

  <Content
    tagline="Our Web Properties"
    title="thisismydemo.cloud"
    subtitle="The blog and demo playground — real-world walkthroughs, lab notes, and community tools."
    items={[
      {
        title: 'Blog & Walkthroughs',
        description: 'Technical blog posts, step-by-step guides, and real-world hybrid cloud scenarios from the field.',
        icon: 'tabler:notebook',
      },
      {
        title: 'Demo Resources',
        description: 'Scripts, templates, and lab environments used in conference demos and training sessions.',
        icon: 'tabler:code',
      },
      {
        title: 'Community Tools',
        description: 'Various open-source tools and utilities shared through the companion GitHub organization.',
        icon: 'tabler:tools',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1499750310107-5fef28a66643?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Blog and demo site',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">thisismydemo.cloud</h3>
      <p class="mb-4">
        A blog and demo site covering hybrid cloud topics, Azure infrastructure, and hands-on lab content. The companion
        GitHub organization hosts various tools and utilities shared with the community.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="https://thisismydemo.cloud"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary sm:w-auto"
        >
          Visit thisismydemo.cloud
        </a>
        <a href="https://github.com/thisismydemo" target="_blank" rel="noopener noreferrer" class="btn sm:w-auto">
          GitHub: thisismydemo
        </a>
      </div>
    </Fragment>
  </Content>

  <!-- Stats Widget ****************** -->

  <Stats
    title="By the Numbers"
    stats={[
      { title: 'Years in Tech', amount: '15+' },
      { title: 'Microsoft MVP & MCT', amount: '✓' },
      { title: 'Active Certifications', amount: '8' },
      { title: 'Exams Passed', amount: '16' },
      { title: 'Conference Sessions', amount: '30+' },
      { title: 'Events & User Groups', amount: '15+' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Work With Us',
        href: '/contact',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title"> Ready to Get Started? </Fragment>

    <Fragment slot="subtitle">
      Let's discuss how Hybrid Cloud Solutions can help your organization modernize with confidence.
    </Fragment>
  </CallToAction>
</Layout>
